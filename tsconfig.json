{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"]
  },
  // netlify/ is in here so the leaderboard function is covered by the same
  // `tsc --noEmit` the build gate runs. Left out, a type error in the endpoint
  // ships silently: vite never touches that directory and Netlify bundles it
  // with esbuild, which strips types without checking them.
  "include": ["src", "tools", "tests", "netlify"]
}
